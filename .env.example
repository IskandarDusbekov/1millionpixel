# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=0
ALLOWED_HOSTS=millionpixel.uz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://millionpixel.uz

# --- Ma'lumotlar bazasi ---
POSTGRES_DB=millionpixel
POSTGRES_USER=mp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

# Docker'da web konteyneri host'ning shu portida ko'rinadi (faqat 127.0.0.1).
# 8000 band bo'lsa o'zgartiring va nginx'da ham shu portni ko'rsating.
WEB_PORT=8000
WEB_WORKERS=2

# --- Kanvas ---
CANVAS_SIZE=1000
MAX_ENERGY=50
BROADCAST_INTERVAL_MS=80
ONLINE_TTL_SEC=45
ONLINE_REFRESH_MS=2000

# --- Avtorizatsiya ---
# DIQQAT: 1 qilinsa, saytga hech qanday tekshiruvsiz kirish mumkin bo'ladi.
# Faqat sinov serverida yoqing. Ishlab chiqarishda har doim 0.
DEV_LOGIN=0

# Mini App manzili (telegram_bot buyrug'i va docker-compose.prod.yml uchun)
PUBLIC_URL=https://millionpixel.uz
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=      # @siz, chaqiruv havolasi uchun
GOOGLE_CLIENT_ID=

# --- Do'st chaqirish ---
INVITE_BONUS_ENERGY=5       # har chaqirilgan do'st uchun qo'shimcha zaxira
INVITE_BONUS_MAX=50         # jami bonus chegarasi
INVITE_MIN_PIXELS=20        # do'st shuncha chizgach bonus beriladi
TEAM_MAX_MEMBERS=50

# --- Timelapse (doska suratlari) ---
TIMELAPSE_MIN_SEC=30        # eng tez oraliq (doska qizg'in chizilayotganda)
TIMELAPSE_MAX_SEC=1800      # eng sekin oraliq (jimjitlikda)
TIMELAPSE_BUSY_PIXELS=2000  # shu qadar o'zgarish = eng tez oraliq
TIMELAPSE_KEEP_DAYS=0       # 0 = suratlarni cheksiz saqlash
JWT_SECRET=change-me-too
JWT_TTL_DAYS=30
